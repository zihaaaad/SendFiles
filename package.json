{
  "name": "sendfiles",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "bin": "dist/server.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --external:vite --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist dist-electron release server.js",
    "lint": "tsc --noEmit",
    "package": "npm run build && node -e \"const fs=require('fs'); fs.writeFileSync('dist/package.json', JSON.stringify({name:'sendfiles',bin:'server.cjs',pkg:{assets:['index.html','assets/**/*','sw.js','favicon.png']}}))\" && pkg dist --targets node18-win-x64,node18-linux-x64 --out-path release",
    "test": "vitest run",
    "build:electron": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --format=cjs --target=node20 --external:electron --out-extension:.js=.cjs --outdir=dist-electron",
    "electron:dev": "npm run build && npm run build:electron && electron dist-electron/main.cjs",
    "electron:pack": "npm run build && npm run build:electron && electron-builder --publish never"
  },
  "pkg": {
    "assets": [
      "dist/**/*"
    ],
    "targets": [
      "node18-win-x64",
      "node18-linux-x64"
    ]
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "electron-updater": "^6.8.9",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "lucide-react": "^0.546.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "redis": "^6.0.0",
    "selfsigned": "^2.4.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "pkg": "^5.8.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.8"
  },
  "main": "dist-electron/main.cjs",
  "description": "Secure zero-configuration peer-to-peer file sharing over your local network.",
  "author": {
    "name": "Zihad Hasan"
  }
}
