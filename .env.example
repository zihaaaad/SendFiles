# ----------------------------------------------------
# Networking
# ----------------------------------------------------

# PORT / HTTPS_PORT: listening ports (defaults 3000 / 3001).
PORT=3000
HTTPS_PORT=3001

# TRUST_PROXY: set when a reverse proxy (Cloud Run, Render, Fly, Railway,
# nginx, ...) sits in front of this server. Use the number of proxies in
# front of you — "1" is correct for nearly every managed platform. "true"
# trusts every hop and is only safe when the app cannot be reached directly.
#
# Leave unset for local/LAN use. Getting this wrong means client IPs resolve
# to the proxy's address, which breaks rate limiting and peer discovery.
TRUST_PROXY=

# DISCOVERY_MODE: who can see whom.
#   lan    - peers sharing a private network are grouped together.
#            Correct for a laptop serving its own Wi-Fi.
#   strict - only an exact client IP match groups peers together.
#   off    - no ambient discovery; lockers are reachable by link only.
#
# Defaults to "lan" on a desktop/packaged build and "strict" everywhere else.
# NEVER use "lan" on a public host: behind a proxy every request arrives from
# the same address, which would put every visitor in one discovery group.
DISCOVERY_MODE=

# ----------------------------------------------------
# Security
# ----------------------------------------------------

# ROOM_TOKEN_SECRET: HMAC secret for locker access tokens. A random one is
# generated per process if unset, which means tokens are invalidated on
# restart and cannot be shared across a multi-instance deployment.
ROOM_TOKEN_SECRET=

# ----------------------------------------------------
# WebRTC / ICE
# ----------------------------------------------------

# OFFLINE_MODE: "true" disables public STUN servers for strict offline LAN
# deployment, preventing WebRTC timeouts with no internet access.
OFFLINE_MODE=true

# Optional self-hosted STUN/TURN. TURN is what makes transfers work across
# restrictive NATs without falling back to the server relay.
STUN_SERVER_URL=
TURN_SERVER_URL=
TURN_SERVER_USERNAME=
TURN_SERVER_CREDENTIAL=

# ----------------------------------------------------
# Scaling (optional)
# ----------------------------------------------------

# REDIS_URL: enables shared locker state, cross-instance signalling relay and
# a cluster-wide peer directory. Set ROOM_TOKEN_SECRET too when using this.
REDIS_URL=

# ----------------------------------------------------
# Frontend build-time configuration
# ----------------------------------------------------

# VITE_SIGNALING_SERVER: point a statically-hosted frontend at a separate
# signalling backend. Leave empty to use the same origin that served the page.
VITE_SIGNALING_SERVER=
